# Copy this file to .env and fill it in. Never commit .env.
#
# ENVIRONMENT: "development" or "production". If missing, the app assumes production.
ENVIRONMENT=development

# SECRET_KEY: at least 32 characters, random. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# CORS_ORIGINS: comma-separated exact origins allowed to call the API from a browser.
# Leave empty when the frontend and API share one origin.
CORS_ORIGINS=

# DATABASE_URL: the limited account the running application uses.
DATABASE_URL=postgresql+psycopg://pillbrook_app:APP_PASSWORD@localhost:5432/pillbrook

# MIGRATION_DATABASE_URL: the owner account, used only to run migrations.
MIGRATION_DATABASE_URL=postgresql+psycopg://pillbrook_owner:OWNER_PASSWORD@localhost:5432/pillbrook

# Used only by the automated tests. The database names must end in _test.
TEST_DATABASE_URL=postgresql+psycopg://pillbrook_app:APP_PASSWORD@localhost:5432/pillbrook_test
TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://pillbrook_owner:OWNER_PASSWORD@localhost:5432/pillbrook_test

# MAIL_MODE: "off" (no email is sent) or "outbox" (development only: each email is saved as a file
# in backend\outbox instead of being sent). Production must use "off" until a real mail service exists.
MAIL_MODE=outbox

# REQUIRE_EMAIL_VERIFICATION: "true" or "false". When true, new accounts must confirm their email
# address, which needs email to be turned on. Leave this false for now.
REQUIRE_EMAIL_VERIFICATION=false